{
  "name": "web-designer-karol",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test": "supabase test db",
    "preview": "vite preview",
    "visual:baseline": "node scripts/snapshot.mjs .snap-before.txt",
